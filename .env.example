# cosmos-edge-serve configuration.
#
# Copy to `.env` and edit:   cp .env.example .env
# `.env` is gitignored. Never commit real tokens.
#
# Every variable below is optional — the defaults shown are what the app uses
# if the variable is absent. Defaults are tuned for the 6 GB dev laptop.

# ===========================================================================
# Model source
# ===========================================================================

# HuggingFace repo id. Only change this if you know what you're doing — the
# service asserts the loaded class is Qwen3VLForConditionalGeneration.
COSMOS_MODEL_ID=nvidia/Cosmos-Reason2-2B

# Optional local directory to load from instead of downloading from HuggingFace.
# Used in Phase 2 after pulling weights from S3. Leave empty to use MODEL_ID.
COSMOS_MODEL_PATH=

# ===========================================================================
# Precision and placement
# ===========================================================================

# nf4  = 4-bit NF4 via bitsandbytes, ~2 GB of weights. Required on the 6 GB
#        RTX 3060 Laptop: fp16 weights alone are ~4.9 GB and will not fit
#        alongside Windows' display reservation, activations, and KV cache.
#        Requires CUDA — NF4 cannot run on CPU.
# none = full fp16, ~4.9 GB. Use this on a T4 (Kaggle or EC2) and anywhere
#        with >= 12 GB of VRAM.
COSMOS_QUANT=nf4

# auto (cuda if available, else cpu) | cuda | cpu
# `cpu` is the escape hatch if VRAM still runs short — correct output, but
# expect 30-60 s per request.
COSMOS_DEVICE=auto

# float16 | bfloat16 | float32
# Leave at float16. T4 is Turing and has NO bfloat16 and NO FP8 hardware.
# The service refuses to start if you request bfloat16 on a GPU without it.
COSMOS_DTYPE=float16

# Attention implementation. sdpa is what NVIDIA's own sample uses and is the
# only one that works across Turing/Ampere/Ada for this architecture.
# Do NOT set this to flash_attention_2 on a T4.
COSMOS_ATTN_IMPL=sdpa

# ===========================================================================
# Adapter (from the featherweight-ai repo). Off by default.
# ===========================================================================

COSMOS_ADAPTER_ENABLED=false
# Local path or HF repo id of a PEFT adapter. Startup fails loudly if
# ADAPTER_ENABLED=true and this is empty or does not resolve.
COSMOS_ADAPTER_PATH=

# ===========================================================================
# Generation and vision budget
# ===========================================================================

# Default output cap. Benchmark profile A uses 256, profile B uses 1024.
# The model emits <think>...</think> reasoning first, and NVIDIA recommends
# 4096+ to avoid truncation — but that is 2-3 minutes per request on a T4.
COSMOS_MAX_NEW_TOKENS=256

# Vision token budget. The processor sizes images so that the token count lands
# in this range (1 visual token = 32x32 = 1024 pixels).
# Laptop/NF4: 256 / 1024.  T4 fp16: raise MAX to 4096.
COSMOS_MIN_VISION_TOKENS=256
COSMOS_MAX_VISION_TOKENS=1024

# Video sampling rate. 4 matches the model's training setup — changing this
# degrades quality. Only override per-request for experiments.
COSMOS_VIDEO_FPS=4

# ===========================================================================
# Serving
# ===========================================================================

# Requests beyond this many queued get 503 + Retry-After rather than piling up.
COSMOS_MAX_QUEUE_DEPTH=32

# Total budget per request, INCLUDING time spent waiting in the queue.
#
# That "including" is the trap. One GPU worker serves requests serially, so the
# last of N concurrent requests waits roughly (N-1) x per-request before it even
# starts. Under load test this ceiling is hit by queue wait, not by slow
# generation, and the caller gets a 504.
#
#   required >= VUs x (max_new_tokens / measured_tok_s) x 1.3
#
# 300 is fine for interactive single-request use. It is NOT enough to benchmark
# 1024-token responses at 8 concurrent requests on a T4 at any plausible decode
# rate — docs/EC2.md sets 900 on the instance for exactly this reason.
COSMOS_REQUEST_TIMEOUT_S=300

# Largest upload accepted, in megabytes. Videos get big fast at fps=4.
COSMOS_MAX_UPLOAD_MB=64

# DEBUG | INFO | WARNING | ERROR
COSMOS_LOG_LEVEL=INFO

# ===========================================================================
# HuggingFace (note: these are NOT COSMOS_-prefixed, they are HF's own vars)
# ===========================================================================

# Where weights are cached. In Docker this is a mounted volume, which is how
# model weights stay OUT of the image.
HF_HOME=/models

# REQUIRED. nvidia/Cosmos-Reason2-2B is a GATED repo — without a token the model
# download fails with a bare HTTP 401 that looks like a network error.
#
# Two one-off steps:
#   1. Sign in to HuggingFace, open
#      https://huggingface.co/nvidia/Cosmos-Reason2-2B and accept the NVIDIA Open
#      Model License. Access is granted automatically, no waiting for approval.
#   2. Create a READ token at https://huggingface.co/settings/tokens and paste it
#      below.
#
# NEVER commit a real token. This file is the example; .env is gitignored.
HF_TOKEN=
